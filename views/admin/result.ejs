<%- include('../partials/header', {title}) %>

<div class="container container-narrow">
  <a href="/admin" class="back-link">← 返回后台</a>
  <div class="page-header"><h1>公布比赛结果</h1></div>

  <div class="card">
    <div class="mdc-teams" style="margin-bottom:1.25rem">
      <div class="mdc-team"><%= match.home_team %> <%= flag(match.home_team) %></div>
      <div class="mdc-sep">VS</div>
      <div class="mdc-team"><%= flag(match.away_team) %> <%= match.away_team %></div>
    </div>
    <div style="text-align:center;margin-bottom:1.5rem">
      <span class="handicap-tag handicap-tag-lg"><%= match.handicap_desc %></span>
    </div>

    <%
      const counts = {a:0, b:0, c:0};
      votes.forEach(v => counts[v.choice]++);
      const totalVoters = votes.length;
    %>

    <!-- 投票统计 -->
    <div class="result-vote-summary">
      <div class="rvs-item"><span class="vote-opt-letter vote-opt-letter-sm">A</span><%= rl(match.option_a, match) %> <strong><%= counts.a %> 人</strong></div>
      <div class="rvs-item"><span class="vote-opt-letter vote-opt-letter-sm">B</span><%= rl(match.option_b, match) %> <strong><%= counts.b %> 人</strong></div>
      <div class="rvs-item"><span class="vote-opt-letter vote-opt-letter-sm">C</span><%= rl(match.option_c, match) %> <strong><%= counts.c %> 人</strong></div>
      <div class="rvs-total">共 <%= totalVoters %> 人参与</div>
    </div>

    <% if (nonVoters && nonVoters.length > 0) { %>
      <div class="non-voters-box">
        <div class="nv-title">⚠️ 未投票（<%= nonVoters.length %> 人）：
          <% nonVoters.forEach(u => { %><span class="nv-chip"><%= u.nickname %></span><% }) %>
        </div>
      </div>
    <% } %>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/admin/matches/<%= match.id %>/result">
      <!-- 实际比分 -->
      <div class="form-group">
        <label class="form-label">实际比分</label>
        <div class="score-input-row">
          <div class="score-team"><%= match.home_team %> <%= flag(match.home_team) %></div>
          <input type="number" name="home_score" class="form-input score-input" min="0" max="20" placeholder="0" required>
          <span class="score-colon">:</span>
          <input type="number" name="away_score" class="form-input score-input" min="0" max="20" placeholder="0" required>
          <div class="score-team"><%= flag(match.away_team) %> <%= match.away_team %></div>
        </div>
      </div>

      <!-- 盘口结果 -->
      <div class="form-group">
        <label class="form-label">盘口结果（竞猜正确答案）</label>
        <div class="result-options">
          <label class="result-option">
            <input type="radio" name="result" value="a" required>
            <div class="result-option-box">A · <%= rl(match.option_a, match) %> （<%= counts.a %> 人）</div>
          </label>
          <label class="result-option">
            <input type="radio" name="result" value="b">
            <div class="result-option-box">B · <%= rl(match.option_b, match) %> （<%= counts.b %> 人）</div>
          </label>
          <label class="result-option">
            <input type="radio" name="result" value="c">
            <div class="result-option-box">C · <%= rl(match.option_c, match) %> （<%= counts.c %> 人）</div>
          </label>
        </div>
      </div>

      <!-- 未投票者处理 -->
      <% if (nonVoters && nonVoters.length > 0) { %>
        <div class="form-group penalize-box">
          <label class="penalize-label">
            <input type="checkbox" name="penalize_nonvoters" value="1" checked>
            <div class="penalize-content">
              <strong>对 <%= nonVoters.length %> 位未投票者扣 100 分</strong>
              <span class="penalize-desc">扣分纳入奖池（猜中者可赢得更多），不计胜场。取消勾选则未投票者不受影响。</span>
            </div>
          </label>
        </div>
      <% } %>

      <div class="form-hint alert-warn" style="margin-top:.5rem">⚠️ 确认后自动结算积分，不可撤销</div>

      <div class="form-actions">
        <a href="/admin/matches/<%= match.id %>/votes" class="btn btn-outline">先修改投票</a>
        <button type="submit" class="btn btn-primary"
          onclick="return confirm('确认公布结果并结算积分？')">公布并结算</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
