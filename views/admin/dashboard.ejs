<%- include('../partials/header', {title}) %>

<div class="container">
  <div class="page-header">
    <h1>⚙️ 管理后台</h1>
    <div>
      <a href="/admin/matches/new" class="btn btn-primary">+ 添加比赛</a>
      <form method="POST" action="/admin/refresh-odds" style="display:inline">
        <button type="submit" class="btn btn-outline" style="margin-left:.5rem">📡 刷新盘口</button>
      </form>
      <form method="POST" action="/admin/check-scores" style="display:inline">
        <button type="submit" class="btn btn-outline" style="margin-left:.5rem">🔄 立即检查赛果</button>
      </form>
      <a href="/admin/stats/contrarian" class="btn btn-outline" style="margin-left:.5rem">🎯 冷门值统计</a>
      <a href="/admin/stats/vote-order" class="btn btn-outline" style="margin-left:.5rem">⏱ 投票次序统计</a>
      <a href="/admin/logout" class="btn btn-outline" style="margin-left:.5rem">退出管理</a>
    </div>
  </div>

  <% if (typeof query !== 'undefined' && query.oddsRefreshed !== undefined) { %>
    <% if (query.oddsRefreshed === 'err') { %>
      <div class="alert alert-error">盘口刷新失败<%= query.oddsErrMsg ? '：' + query.oddsErrMsg : '，请查看服务器日志' %></div>
    <% } else { %>
      <div class="alert alert-success">盘口刷新完成，本次更新 <%= query.oddsRefreshed %> 场（已有投票的比赛已跳过）</div>
    <% } %>
  <% } %>
  <% if (typeof query !== 'undefined' && query.scoresChecked !== undefined) { %>
    <% if (query.scoresChecked === 'err') { %>
      <div class="alert alert-error">赛果检查失败，请查看服务器日志</div>
    <% } else { %>
      <div class="alert alert-success">赛果检查完成，本次自动结算 <%= query.scoresChecked %> 场（详情见服务器日志）</div>
    <% } %>
  <% } %>

  <!-- 危险操作区 -->
  <div class="danger-zone">
    <span>🧹 测试完毕？</span>
    <form method="POST" action="/admin/reset-all"
          onsubmit="return confirm('⚠️ 确认清空所有用户、投票和积分记录？\n比赛和盘口数据保留，此操作不可恢复！')">
      <button class="btn btn-danger btn-sm">清空全部测试数据</button>
    </form>
  </div>

  <div class="admin-grid">

    <!-- 比赛管理 -->
    <section class="section">
      <h2>📋 比赛管理</h2>
      <% if (matches.length === 0) { %>
        <div class="empty-state">还没有比赛，先添加一场吧</div>
      <% } else { %>
        <div class="admin-match-list">
          <% matches.forEach(m => { %>
            <div class="admin-match-row">
              <div class="amr-info">
                <div class="amr-teams"><%= m.home_team %> vs <%= m.away_team %></div>
                <div class="amr-meta">
                  <span class="handicap-tag"><%= m.handicap_desc %></span>
                  <% if (m.manual_odds) { %><span class="badge-voting" title="自动抓取盘口不会覆盖">✋ 手动锁定</span><% } %>
                  <span><%= m.stage %></span>
                  <span><%= new Date(m.match_time).toLocaleString('zh-CN', {month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit',timeZone:'Asia/Shanghai'}) %></span>
                  <span class="status-badge-<%= m.status %>">
                    <%= m.status === 'upcoming' ? '未开始' : m.status === 'voting' ? '投票中' : m.status === 'closed' ? '已截止' : '已完成' %>
                  </span>
                </div>
                <% if (m.status === 'finished') { %>
                  <div class="amr-result">
                    结果: <strong><%= m.result === 'a' ? m.option_a : m.result === 'b' ? m.option_b : m.option_c %></strong>
                  </div>
                <% } %>
              </div>
              <div class="amr-actions">
                <% if (m.status !== 'finished') { %>
                  <a href="/admin/matches/<%= m.id %>/edit" class="btn btn-sm btn-outline">编辑</a>
                  <a href="/admin/matches/<%= m.id %>/odds" class="btn btn-sm btn-outline">🎯 调整盘口</a>
                  <% if (m.status === 'upcoming') { %>
                    <form method="POST" action="/admin/matches/<%= m.id %>/status" style="display:inline">
                      <input type="hidden" name="status" value="voting">
                      <button class="btn btn-sm btn-primary">开放投票</button>
                    </form>
                  <% } else if (m.status === 'voting') { %>
                    <form method="POST" action="/admin/matches/<%= m.id %>/status" style="display:inline">
                      <input type="hidden" name="status" value="closed">
                      <button class="btn btn-sm btn-warn">截止投票</button>
                    </form>
                  <% } %>
                  <a href="/admin/matches/<%= m.id %>/votes" class="btn btn-sm btn-outline">✏️ 投票</a>
                  <a href="/admin/matches/<%= m.id %>/result" class="btn btn-sm btn-success">公布结果</a>
                  <form method="POST" action="/admin/matches/<%= m.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除该比赛及所有投票？')">
                    <button class="btn btn-sm btn-danger">删除</button>
                  </form>
                <% } else { %>
                  <a href="/admin/matches/<%= m.id %>/votes"       class="btn btn-sm btn-outline">✏️ 投票</a>
                  <a href="/admin/matches/<%= m.id %>/edit-result" class="btn btn-sm btn-warn">修改结果</a>
                  <a href="/matches/<%= m.id %>"                   class="btn btn-sm btn-outline">查看</a>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- 用户管理 -->
    <section class="section">
      <h2>👥 用户管理</h2>
      <% if (typeof query !== 'undefined' && query.user_error) { %>
        <div class="alert alert-error"><%= query.user_error %></div>
      <% } %>
      <% if (users.length === 0) { %>
        <div class="empty-state">还没有用户注册</div>
      <% } else { %>
        <div class="user-manage-list">
          <% users.forEach(u => { %>
            <div class="user-row">
              <div class="user-row-info">
                <span class="user-nickname"><%= u.nickname %></span>
                <span class="user-stats">
                  <span class="<%= u.total_points > 0 ? 'positive' : u.total_points < 0 ? 'negative' : '' %>">
                    <%= u.total_points > 0 ? '+' : '' %><%= u.total_points %>分
                  </span>
                  · <%= u.wins %>胜 · <%= u.total_votes %>场
                  · <strong><%= u.total_votes > 0 ? (u.wins/u.total_votes*100).toFixed(1) : '0.0' %>%</strong>胜率
                  · Pin码：<% if (u.pin) { %><strong><%= u.pin %></strong><% } else { %><span style="color:#9ca3af">未设置</span><% } %>
                  · 虚拟投票剩余：<strong style="color:<%= u.virtual_votes_left > 0 ? '#dc2626' : '#9ca3af' %>"><%= u.virtual_votes_left %>/6</strong>
                </span>
              </div>
              <div class="user-row-actions">
                <!-- 改名 -->
                <form method="POST" action="/admin/users/<%= u.id %>/rename" class="inline-form rename-form" style="display:none" id="rename-<%= u.id %>">
                  <input type="text" name="nickname" class="form-input form-input-sm" value="<%= u.nickname %>" maxlength="20" required>
                  <button class="btn btn-sm btn-primary">保存</button>
                  <button type="button" class="btn btn-sm btn-outline" onclick="cancelRename(<%= u.id %>)">取消</button>
                </form>
                <div class="user-btns" id="btns-<%= u.id %>">
                  <a href="/admin/users/<%= u.id %>/activity" class="btn btn-sm btn-outline">🕵️ 活动记录</a>
                  <button class="btn btn-sm btn-outline" onclick="showRename(<%= u.id %>)">✏️ 改名</button>
                  <% if (u.pin) { %>
                    <form method="POST" action="/admin/users/<%= u.id %>/reset-pin" style="display:inline"
                          onsubmit="return confirm('确认重置「<%= u.nickname %>」的Pin码？重置后该用户下次登录需重新设置。')">
                      <button class="btn btn-sm btn-outline">🔑 重置Pin码</button>
                    </form>
                  <% } %>
                  <% if (u.virtual_votes_left < 6) { %>
                    <form method="POST" action="/admin/users/<%= u.id %>/reset-virtual" style="display:inline"
                          onsubmit="return confirm('确认将「<%= u.nickname %>」的虚拟投票次数恢复为6次？')">
                      <button class="btn btn-sm btn-outline">🔴 重置虚拟投票</button>
                    </form>
                  <% } %>
                  <form method="POST" action="/admin/users/<%= u.id %>/reset-points" style="display:inline"
                        onsubmit="return confirm('确认重置「<%= u.nickname %>」的积分？')">
                    <button class="btn btn-sm btn-warn">↺ 重置积分</button>
                  </form>
                  <form method="POST" action="/admin/users/<%= u.id %>/delete" style="display:inline"
                        onsubmit="return confirm('确认删除账号「<%= u.nickname %>」？该操作不可恢复！')">
                    <button class="btn btn-sm btn-danger">🗑 删除</button>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

  </div>
</div>

<!-- 淘汰队伍管理 -->
<div class="section" style="margin-top:1.5rem">
  <h2>🚫 淘汰队伍管理</h2>
  <p style="font-size:.82rem;color:#6b7280;margin-bottom:1rem">标记已淘汰的球队，冠军预测页中对应预测会变灰</p>
  <div class="elim-grid">
    <% const allTeams = ['巴西','法国','阿根廷','德国','英格兰','西班牙','葡萄牙','荷兰','比利时',
      '墨西哥','美国','日本','韩国','澳大利亚','乌拉圭','土耳其','挪威','加拿大','哥伦比亚',
      '塞内加尔','摩洛哥','埃及','克罗地亚','奥地利','瑞士','伊朗','南非','捷克','波黑','卡塔尔',
      '海地','苏格兰','巴拉圭','科特迪瓦','厄瓜多尔','库拉索','突尼斯','瑞典','新西兰','伊拉克',
      '阿尔及利亚','约旦','刚果','乌兹别克斯坦','加纳','巴拿马','沙特阿拉伯','佛得角']; %>
    <% allTeams.forEach(team => { %>
      <% const isElim = eliminated.includes(team); %>
      <form method="POST" action="/admin/eliminate" class="elim-item">
        <input type="hidden" name="team" value="<%= team %>">
        <input type="hidden" name="action" value="<%= isElim ? 'remove' : 'add' %>">
        <button type="submit" class="elim-btn <%= isElim ? 'elim-active' : '' %>">
          <%= isElim ? '✗' : '' %> <%= team %>
        </button>
      </form>
    <% }) %>
  </div>
</div>

<script>
function showRename(id) {
  document.getElementById('rename-' + id).style.display = 'flex';
  document.getElementById('btns-' + id).style.display = 'none';
  document.querySelector('#rename-' + id + ' input').focus();
}
function cancelRename(id) {
  document.getElementById('rename-' + id).style.display = 'none';
  document.getElementById('btns-' + id).style.display = 'flex';
}
</script>
<%- include('../partials/footer') %>
