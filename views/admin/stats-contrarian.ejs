<%- include('../partials/header', {title}) %>

<div class="container">
  <a href="/admin" class="back-link">← 返回后台</a>
  <div class="page-header">
    <h1>🎯 冷门值统计</h1>
  </div>

  <div class="info-box" style="margin-bottom:1.5rem">
    <p>每场比赛，用户选择的选项在全体投票者中被多少人选中，把这个人数累加到该用户名下。
    <strong>总和越低</strong>，说明这个人越倾向于选择少数人选的冷门选项；总和越高，说明越倾向随大流。</p>
  </div>

  <% if (stats.length === 0) { %>
    <div class="empty-state">暂无投票数据</div>
  <% } else { %>
    <table class="lb-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>昵称</th>
          <th>参与场次</th>
          <th>冷门值总和</th>
          <th>场均冷门值</th>
        </tr>
      </thead>
      <tbody>
        <% stats.forEach((s, i) => { %>
          <tr>
            <td class="rank-cell"><%= i+1 %></td>
            <td class="name-cell"><%= s.nickname %></td>
            <td><%= s.vote_count %></td>
            <td><strong><%= s.total_crowd %></strong></td>
            <td><%= s.avg_crowd %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="section" style="margin-top:1.5rem">
      <h2 style="font-size:1rem;color:#374151;margin-bottom:.75rem">📊 冷门值总和分布</h2>
      <div style="position:relative;height:400px">
        <canvas id="contrarianChart"></canvas>
      </div>
    </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const STATS = <%- JSON.stringify(stats) %>;
new Chart(document.getElementById('contrarianChart').getContext('2d'), {
  type: 'bar',
  data: {
    labels: STATS.map(s => s.nickname),
    datasets: [{
      label: '冷门值总和',
      data: STATS.map(s => s.total_crowd),
      backgroundColor: '#0F5499',
      borderRadius: 4,
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { ticks: { font: { size: 11 }, color: '#666' }, grid: { display: false } },
      y: { beginAtZero: true, ticks: { font: { size: 11 }, color: '#666' }, grid: { color: '#e8e8e8' } }
    }
  }
});
</script>

<%- include('../partials/footer') %>
