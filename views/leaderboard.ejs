<%- include('partials/header', {title}) %>

<div class="container">
  <div class="page-header">
    <h1>🏆 排行榜</h1>
  </div>

  <div class="lb-tabs">
    <button class="lb-tab active" onclick="switchTab('points')">积分排行</button>
    <button class="lb-tab" onclick="switchTab('wins')">获胜场次排行</button>
    <button class="lb-tab" onclick="switchTab('champion')">🏆 冠军预测</button>
    <button class="lb-tab" onclick="switchTab('trend')">📈 积分走势</button>
  </div>

  <!-- 积分排行 -->
  <div id="tab-points" class="lb-table-wrap">
    <table class="lb-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>昵称</th>
          <th>总积分</th>
          <th>获胜场次</th>
          <th>参与场次</th>
        </tr>
      </thead>
      <tbody>
        <% const byPoints = [...users].sort((a,b) => b.total_points - a.total_points || b.wins - a.wins); %>
        <% byPoints.forEach((u, i) => { %>
          <tr class="<%= i < 3 ? 'top-row' : '' %>">
            <td class="rank-cell">
              <% if (i === 0) { %>🥇
              <% } else if (i === 1) { %>🥈
              <% } else if (i === 2) { %>🥉
              <% } else { %><%= i+1 %>
              <% } %>
            </td>
            <td class="name-cell">
              <%= u.nickname %><% if(u.predicted_champion){%><span class="champ-flag" title="预测冠军：<%= u.predicted_champion %>"><%= flag(u.predicted_champion) %></span><%}%>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">你</span><% } %>
            </td>
            <td class="pts-cell <%= u.total_points > 0 ? 'positive' : u.total_points < 0 ? 'negative' : '' %>">
              <%= u.total_points > 0 ? '+' : '' %><%= u.total_points %>
            </td>
            <td><%= u.wins %></td>
            <td><%= u.total_votes %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (users.length === 0) { %>
      <div class="empty-state">还没有参与者，快来第一个加入！</div>
    <% } %>
  </div>

  <!-- 获胜场次排行 -->
  <div id="tab-wins" class="lb-table-wrap" style="display:none">
    <table class="lb-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>昵称</th>
          <th>获胜场次</th>
          <th>总积分</th>
          <th>参与场次</th>
          <th class="wr-col">胜率</th>
        </tr>
      </thead>
      <tbody>
        <% const byWins = [...users].sort((a,b) => b.wins - a.wins || b.total_points - a.total_points); %>
        <% byWins.forEach((u, i) => { %>
          <tr class="<%= i < 3 ? 'top-row' : '' %>">
            <td class="rank-cell">
              <% if (i === 0) { %>🥇
              <% } else if (i === 1) { %>🥈
              <% } else if (i === 2) { %>🥉
              <% } else { %><%= i+1 %>
              <% } %>
            </td>
            <td class="name-cell">
              <%= u.nickname %><% if(u.predicted_champion){%><span class="champ-flag" title="预测冠军：<%= u.predicted_champion %>"><%= flag(u.predicted_champion) %></span><%}%>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">你</span><% } %>
            </td>
            <td><%= u.wins %></td>
            <td class="pts-cell <%= u.total_points > 0 ? 'positive' : u.total_points < 0 ? 'negative' : '' %>">
              <%= u.total_points > 0 ? '+' : '' %><%= u.total_points %>
            </td>
            <td><%= u.total_votes %></td>
            <td><%= u.total_votes > 0 ? Math.round(u.wins/u.total_votes*100) : 0 %>%</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 冠军预测 -->
  <div id="tab-champion" class="lb-table-wrap" style="display:none">
    <% const withChampion = users.filter(u => u.predicted_champion); %>
    <% if (withChampion.length === 0) { %>
      <div class="empty-state" style="padding:2rem">还没有人预测冠军</div>
    <% } else { %>
      <div class="champion-grid">
        <% withChampion.forEach(u => {
             const isElim = eliminated.includes(u.predicted_champion);
        %>
          <div class="champion-card <%= isElim ? 'champion-eliminated' : '' %>">
            <div class="cc-flag"><%= flag(u.predicted_champion) %></div>
            <div class="cc-team"><%= u.predicted_champion %></div>
            <div class="cc-user">
              <%= u.nickname %>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">我</span><% } %>
            </div>
            <% if (isElim) { %><div class="cc-eliminated">已淘汰</div><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% if (currentUser) { %>
      <div style="text-align:center;margin-top:1.5rem">
        <a href="/pick-champion" class="btn btn-outline btn-sm">修改我的预测</a>
      </div>
    <% } %>
  </div>

  <!-- 积分走势图 -->
  <div id="tab-trend" class="lb-table-wrap" style="display:none">
    <div style="position:relative;height:520px;padding:.5rem 0">
      <canvas id="trendChart"></canvas>
    </div>
    <div id="trend-empty" class="empty-state" style="display:none;padding:3rem">暂无积分记录</div>
  </div>

  <!-- 积分走势（嵌入在积分排行 tab 下方，共用数据） -->
  <div id="points-trend-wrap" style="margin-top:2rem;display:block">
    <div class="section-header" style="margin-bottom:.75rem"><h3 style="margin:0;font-size:1rem;color:#374151">📈 积分走势</h3></div>
    <div style="position:relative;height:400px">
      <canvas id="trendChartInline"></canvas>
    </div>
    <div id="points-trend-empty" class="empty-state" style="display:none;padding:2rem">暂无积分记录</div>
  </div>

  <div class="rules-box">
    <h3>📋 积分规则</h3>
    <p>每场比赛基础分 <strong>100 点</strong>。猜中者平分所有猜错者的积分；猜错者扣除 100 分。</p>
    <p>例：10 人参与，1 人猜中 → 该人获得 <strong>+900 分</strong>，其余 9 人各扣 <strong>100 分</strong>。</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const TABS = ['points','wins','champion','trend'];
let chartData = null;
let trendChartRendered = false;

// 右侧留白：最长标签（人名+旗帜）所需宽度
function labelPadding(datasets) {
  const longest = datasets.reduce((m, d) => {
    const len = (d.label + (d.flag || '')).length;
    return len > m ? len : m;
  }, 0);
  return Math.max(longest * 9 + 14, 50);
}

function buildChartOptions(rightPad) {
  return {
    responsive: true,
    maintainAspectRatio: false,
    layout: { padding: { right: rightPad, top: 8 } },
    interaction: { mode: 'index', intersect: false },
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: {
          label: c => `${c.dataset.label}${c.dataset.flag ? ' '+c.dataset.flag : ''}: ${c.parsed.y > 0 ? '+' : ''}${c.parsed.y}`
        }
      }
    },
    scales: {
      x: {
        grid: { color: '#e8e8e8' },
        ticks: { font: { size: 11 }, color: '#666' }
      },
      y: {
        grid: { color: '#e8e8e8' },
        ticks: { font: { size: 11 }, color: '#666', callback: v => (v > 0 ? '+' : '') + v }
      }
    },
    animation: {
      onComplete() {
        const chart = this;
        const ctx2 = chart.ctx;
        ctx2.save();
        ctx2.font = '600 12px -apple-system,sans-serif';
        ctx2.textAlign = 'left';

        // 收集末端坐标，按 y 排序后防重叠
        const entries = [];
        chart.data.datasets.forEach((ds, i) => {
          const meta = chart.getDatasetMeta(i);
          if (!meta.visible || meta.data.length === 0) return;
          const last = meta.data[meta.data.length - 1];
          entries.push({ x: last.x, y: last.y, color: ds.borderColor,
                         text: ds.label + (ds.flag ? ' ' + ds.flag : '') });
        });

        // 按 y 排序后，相邻标签最小间距 16px
        entries.sort((a, b) => a.y - b.y);
        for (let i = 1; i < entries.length; i++) {
          if (entries[i].y - entries[i-1].y < 16) {
            entries[i].y = entries[i-1].y + 16;
          }
        }

        entries.forEach(e => {
          ctx2.fillStyle = e.color;
          ctx2.fillText(e.text, e.x + 7, e.y + 4);
        });
        ctx2.restore();
      }
    }
  };
}

function renderChart(canvasId, data) {
  const pad = labelPadding(data.datasets);
  new Chart(document.getElementById(canvasId).getContext('2d'), {
    type: 'line', data, options: buildChartOptions(pad)
  });
}

function switchTab(tab) {
  TABS.forEach(t => {
    document.getElementById('tab-'+t).style.display = t === tab ? '' : 'none';
  });
  // 积分排行 tab 下方的走势图随 tab 一起显示/隐藏
  document.getElementById('points-trend-wrap').style.display = tab === 'points' ? '' : 'none';
  document.querySelectorAll('.lb-tab').forEach((el, i) => {
    el.classList.toggle('active', i === TABS.indexOf(tab));
  });
  if (tab === 'trend' && !trendChartRendered) {
    const doRender = () => {
      trendChartRendered = true;
      if (!chartData.datasets || chartData.datasets.length === 0) {
        document.getElementById('trendChart').style.display = 'none';
        document.getElementById('trend-empty').style.display = '';
      } else {
        renderChart('trendChart', chartData);
      }
    };
    chartData ? doRender() : loadChartData(doRender);
  }
}

function loadChartData(cb) {
  fetch('/leaderboard/chart-data').then(r => r.json()).then(data => {
    chartData = data;
    cb && cb();
  });
}

// 页面加载时直接渲染积分排行下方的内联走势图
loadChartData(() => {
  if (!chartData.datasets || chartData.datasets.length === 0) {
    document.getElementById('points-trend-empty').style.display = '';
    document.getElementById('trendChartInline').style.display = 'none';
    document.getElementById('trend-empty').style.display = '';
    document.getElementById('trendChart').style.display = 'none';
    return;
  }
  renderChart('trendChartInline', chartData);
});
</script>

<%- include('partials/footer') %>
