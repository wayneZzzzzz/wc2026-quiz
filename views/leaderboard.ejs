<%- include('partials/header', {title}) %>

<div class="container">
  <div class="page-header">
    <h1>🏆 排行榜</h1>
  </div>

  <div class="lb-tabs">
    <button class="lb-tab active" onclick="switchTab('points')">积分排行</button>
    <button class="lb-tab" onclick="switchTab('wins')">获胜场次排行</button>
    <button class="lb-tab" onclick="switchTab('champion')">🏆 冠军预测</button>
    <button class="lb-tab" onclick="switchTab('trend')">📈 积分走势</button>
  </div>

  <!-- 积分排行 -->
  <div id="tab-points" class="lb-table-wrap">
    <table class="lb-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>昵称</th>
          <th>总积分</th>
          <th>获胜场次</th>
          <th>参与场次</th>
        </tr>
      </thead>
      <tbody>
        <% const byPoints = [...users].sort((a,b) => b.total_points - a.total_points || b.wins - a.wins); %>
        <% byPoints.forEach((u, i) => { %>
          <tr class="<%= i < 3 ? 'top-row' : '' %>">
            <td class="rank-cell">
              <% if (i === 0) { %>🥇
              <% } else if (i === 1) { %>🥈
              <% } else if (i === 2) { %>🥉
              <% } else { %><%= i+1 %>
              <% } %>
            </td>
            <td class="name-cell">
              <%= u.nickname %><% if(u.predicted_champion){%><span class="champ-flag" title="预测冠军：<%= u.predicted_champion %>"><%= flag(u.predicted_champion) %></span><%}%>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">你</span><% } %>
            </td>
            <td class="pts-cell <%= u.total_points > 0 ? 'positive' : u.total_points < 0 ? 'negative' : '' %>">
              <%= u.total_points > 0 ? '+' : '' %><%= u.total_points %>
            </td>
            <td><%= u.wins %></td>
            <td><%= u.total_votes %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (users.length === 0) { %>
      <div class="empty-state">还没有参与者，快来第一个加入！</div>
    <% } %>
  </div>

  <!-- 获胜场次排行 -->
  <div id="tab-wins" class="lb-table-wrap" style="display:none">
    <table class="lb-table">
      <thead>
        <tr>
          <th>排名</th>
          <th>昵称</th>
          <th>获胜场次</th>
          <th>总积分</th>
          <th>参与场次</th>
          <th class="wr-col">胜率</th>
        </tr>
      </thead>
      <tbody>
        <% const byWins = [...users].sort((a,b) => b.wins - a.wins || b.total_points - a.total_points); %>
        <% byWins.forEach((u, i) => { %>
          <tr class="<%= i < 3 ? 'top-row' : '' %>">
            <td class="rank-cell">
              <% if (i === 0) { %>🥇
              <% } else if (i === 1) { %>🥈
              <% } else if (i === 2) { %>🥉
              <% } else { %><%= i+1 %>
              <% } %>
            </td>
            <td class="name-cell">
              <%= u.nickname %><% if(u.predicted_champion){%><span class="champ-flag" title="预测冠军：<%= u.predicted_champion %>"><%= flag(u.predicted_champion) %></span><%}%>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">你</span><% } %>
            </td>
            <td><%= u.wins %></td>
            <td class="pts-cell <%= u.total_points > 0 ? 'positive' : u.total_points < 0 ? 'negative' : '' %>">
              <%= u.total_points > 0 ? '+' : '' %><%= u.total_points %>
            </td>
            <td><%= u.total_votes %></td>
            <td><%= u.total_votes > 0 ? Math.round(u.wins/u.total_votes*100) : 0 %>%</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- 冠军预测 -->
  <div id="tab-champion" class="lb-table-wrap" style="display:none">
    <% const withChampion = users.filter(u => u.predicted_champion); %>
    <% if (withChampion.length === 0) { %>
      <div class="empty-state" style="padding:2rem">还没有人预测冠军</div>
    <% } else { %>
      <div class="champion-grid">
        <% withChampion.forEach(u => {
             const isElim = eliminated.includes(u.predicted_champion);
        %>
          <div class="champion-card <%= isElim ? 'champion-eliminated' : '' %>">
            <div class="cc-flag"><%= flag(u.predicted_champion) %></div>
            <div class="cc-team"><%= u.predicted_champion %></div>
            <div class="cc-user">
              <%= u.nickname %>
              <% if (currentUser && u.id === currentUser.id) { %><span class="you-tag">我</span><% } %>
            </div>
            <% if (isElim) { %><div class="cc-eliminated">已淘汰</div><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <% if (currentUser) { %>
      <div style="text-align:center;margin-top:1.5rem">
        <a href="/pick-champion" class="btn btn-outline btn-sm">修改我的预测</a>
      </div>
    <% } %>
  </div>

  <!-- 积分走势图 -->
  <div id="tab-trend" class="lb-table-wrap" style="display:none">
    <div style="position:relative;height:420px;padding:.5rem 0">
      <canvas id="trendChart"></canvas>
    </div>
    <div id="trend-empty" class="empty-state" style="display:none;padding:3rem">暂无积分记录</div>
  </div>

  <div class="rules-box">
    <h3>📋 积分规则</h3>
    <p>每场比赛基础分 <strong>100 点</strong>。猜中者平分所有猜错者的积分；猜错者扣除 100 分。</p>
    <p>例：10 人参与，1 人猜中 → 该人获得 <strong>+900 分</strong>，其余 9 人各扣 <strong>100 分</strong>。</p>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
const TABS = ['points','wins','champion','trend'];
let chartLoaded = false;

function switchTab(tab) {
  TABS.forEach(t => {
    document.getElementById('tab-'+t).style.display = t === tab ? '' : 'none';
  });
  document.querySelectorAll('.lb-tab').forEach((el, i) => {
    el.classList.toggle('active', i === TABS.indexOf(tab));
  });
  if (tab === 'trend' && !chartLoaded) loadTrendChart();
}

function loadTrendChart() {
  fetch('/leaderboard/chart-data')
    .then(r => r.json())
    .then(data => {
      chartLoaded = true;
      if (!data.datasets || data.datasets.length === 0) {
        document.getElementById('trendChart').style.display = 'none';
        document.getElementById('trend-empty').style.display = '';
        return;
      }
      const ctx = document.getElementById('trendChart').getContext('2d');
      new Chart(ctx, {
        type: 'line',
        data: data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: ctx => `${ctx.dataset.label}: ${ctx.parsed.y > 0 ? '+' : ''}${ctx.parsed.y}`
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#f0f0f0' },
              ticks: { font: { size: 12 } }
            },
            y: {
              grid: { color: '#f0f0f0' },
              ticks: {
                font: { size: 12 },
                callback: v => (v > 0 ? '+' : '') + v
              }
            }
          },
          // 在折线末端显示人名标签
          animation: {
            onComplete() {
              const chart = this;
              const ctx2 = chart.ctx;
              ctx2.save();
              ctx2.font = 'bold 12px sans-serif';
              ctx2.textAlign = 'left';
              chart.data.datasets.forEach((ds, i) => {
                const meta = chart.getDatasetMeta(i);
                if (!meta.visible || meta.data.length === 0) return;
                const last = meta.data[meta.data.length - 1];
                ctx2.fillStyle = ds.borderColor;
                ctx2.fillText(ds.label, last.x + 6, last.y + 4);
              });
              ctx2.restore();
            }
          }
        }
      });
    });
}
</script>

<%- include('partials/footer') %>
