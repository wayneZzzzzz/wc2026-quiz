<%- include('partials/header', {title}) %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon">⚽</div>
    <h1 class="auth-title">加入竞猜</h1>
    <p class="auth-sub">输入昵称加入；已设置Pin码的账号需输入Pin码登录</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- 已有用户快速选择 -->
    <% if (existingUsers.length > 0) { %>
      <div class="quick-login">
        <div class="ql-label">已有成员，点击直接登入：</div>
        <div class="ql-chips">
          <% existingUsers.forEach(u => { %>
            <button type="button" class="ql-chip" onclick="fillNickname('<%= u.nickname.replace(/'/g, "\\'") %>')">
              <%= u.nickname %>
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>

    <form method="POST" action="/login" id="login-form">
      <div class="form-group">
        <label class="form-label">你的昵称</label>
        <input type="text" name="nickname" id="nickname-input" class="form-input"
          placeholder="输入或点击上方选择..." maxlength="20" autofocus required>
        <div class="form-hint">
          ⚠️ 昵称区分大小写，再次登入请保持与上次完全一致（如：<strong>Wayne</strong> 和 <strong>wayne</strong> 是不同账号）
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Pin码（首次登录可不填，之后会要求设置）</label>
        <input type="text" name="pin" class="form-input" inputmode="numeric" pattern="\d{4}"
          maxlength="4" placeholder="如已设置Pin码请输入">
      </div>
      <button type="submit" id="login-submit-btn" class="btn btn-primary btn-block">进入竞猜</button>
    </form>

    <div class="auth-rules">
      <h3>📋 竞猜规则</h3>
      <ul>
        <li>每场比赛设三个选项，根据亚洲盘口设定</li>
        <li>每场基础分 <strong>100 点</strong>，猜中者平分猜错者的积分</li>
        <li>排行榜分两个维度：<strong>积分</strong> 和 <strong>获胜场次</strong></li>
        <li>投票前看不到他人选择，投票后可查看</li>
        <li>比赛开始<strong>提前24小时</strong>开放投票，开赛即截止</li>
      </ul>
    </div>
  </div>
</div>

<script>
function fillNickname(name) {
  document.getElementById('nickname-input').value = name;
  document.getElementById('nickname-input').focus();
}

// 提交前检查：本设备/IP是否此前登录过其他账号，若是则弹窗提醒二次确认
const loginForm = document.getElementById('login-form');
let conflictConfirmed = false;
loginForm.addEventListener('submit', async function(e) {
  if (conflictConfirmed) return; // 用户已确认过，直接放行
  e.preventDefault();

  const nickname = document.getElementById('nickname-input').value.trim();
  const btn = document.getElementById('login-submit-btn');
  btn.disabled = true;

  let conflict = false, promptId = null;
  try {
    const resp = await fetch('/login/check-conflict?nickname=' + encodeURIComponent(nickname));
    const data = await resp.json();
    conflict = !!data.conflict;
    promptId = data.promptId || null;
  } catch (err) {
    conflict = false; // 检查失败时不阻塞登录
  }

  btn.disabled = false;

  if (conflict) {
    const ok = confirm('你正在使用与之前使用的账号不同的账号登录，你确定登录吗？');
    if (promptId) {
      try {
        await fetch('/login/check-conflict/' + promptId + '/resolve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ outcome: ok ? 'confirmed' : 'cancelled' }),
        });
      } catch (err) {} // 上报失败不影响用户实际登录操作
    }
    if (!ok) return;
  }

  conflictConfirmed = true;
  loginForm.requestSubmit ? loginForm.requestSubmit() : loginForm.submit();
});
</script>

<%- include('partials/footer') %>
