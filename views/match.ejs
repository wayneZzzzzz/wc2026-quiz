<%- include('partials/header', {title}) %>

<div class="container container-narrow">
  <a href="/matches" class="back-link">← 返回赛程</a>

  <div class="match-detail-card">
    <div class="mdc-stage-row">
      <span class="mcf-stage"><%= match.stage %></span>
      <span class="mcf-status status-badge-<%= effectiveStatus %>" style="font-size:.85rem">
        <% if(effectiveStatus==='upcoming'){%>⏳ 尚未开放<%}else if(effectiveStatus==='voting'){%>🔴 投票中<%}else if(effectiveStatus==='closed'){%>⏸ 等待公布<%}else{%>✅ 已结束<%}%>
      </span>
    </div>

    <div class="mdc-teams">
      <div class="mdc-team"><%= match.home_team %> <span class="team-flag"><%= flag(match.home_team) %></span></div>
      <div class="mdc-sep">VS</div>
      <div class="mdc-team"><span class="team-flag"><%= flag(match.away_team) %></span> <%= match.away_team %></div>
    </div>

    <div class="dual-time">
      <div class="dt-item">
        <span class="dt-label">🇨🇳 北京时间</span>
        <span class="dt-val"><%= fmtBJ(match.match_time) %></span>
      </div>
      <div class="dt-divider"></div>
      <div class="dt-item">
        <span class="dt-label">🇺🇸 美东时间</span>
        <span class="dt-val"><%= fmtET(match.match_time) %></span>
      </div>
    </div>

    <div class="mdc-handicap">
      <span class="handicap-tag handicap-tag-lg"><%= match.handicap_desc %></span>
    </div>

    <% if (effectiveStatus === 'finished') { %>
      <div class="result-banner">
        <div class="result-label">最终结果</div>
        <div class="result-answer"><%= match.result==='a'?match.option_a:match.result==='b'?match.option_b:match.option_c %></div>
        <% if (myLog) { %>
          <div class="my-result <%= myLog.points > 0 ? 'win' : 'lose' %>">
            <%= myLog.points > 0 ? '🎉' : '😢' %> <%= myLog.description %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- 投票区 -->
  <% if (effectiveStatus === 'voting') { %>
    <div class="vote-section">
      <% if (!currentUser) { %>
        <div class="vote-prompt"><a href="/login" class="btn btn-primary">登录后参与投票</a></div>
      <% } else if (myVote) { %>
        <div class="voted-banner">
          <div class="voted-label">✅ 你已投票</div>
          <div class="voted-choice">你选择了：<strong><%= myVote.choice==='a'?match.option_a:myVote.choice==='b'?match.option_b:match.option_c %></strong></div>
        </div>
      <% } else { %>
        <h2 class="vote-title">选择你的预测</h2>
        <p class="vote-subtitle">盘口：<strong><%= match.handicap_desc %></strong></p>
        <form method="POST" action="/votes" class="vote-form">
          <input type="hidden" name="match_id" value="<%= match.id %>">
          <div class="vote-options">
            <% [['a', match.option_a], ['b', match.option_b], ['c', match.option_c]].forEach(([k, label]) => { %>
              <label class="vote-option">
                <input type="radio" name="choice" value="<%= k %>" <%= k==='a'?'required':'' %>>
                <div class="vote-option-box">
                  <span class="vote-opt-letter"><%= k.toUpperCase() %></span>
                  <span class="vote-opt-label"><%= label %></span>
                </div>
              </label>
            <% }) %>
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg">确认投票</button>
          <div class="vote-hint">投票后不可更改 · 投票后可查看他人选择</div>
        </form>
      <% } %>
    </div>
  <% } else if (effectiveStatus === 'upcoming') { %>
    <div class="info-box">
      <p>📅 比赛前一天开放投票，请届时回来参与！</p>
      <div class="options-preview">
        <% [['a', match.option_a], ['b', match.option_b], ['c', match.option_c]].forEach(([k, label]) => { %>
          <div class="op-item">
            <span class="vote-opt-letter vote-opt-letter-sm"><%= k.toUpperCase() %></span>
            <span><%= label %></span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } else if (effectiveStatus === 'closed' && !myVote) { %>
    <div class="info-box info-box-warn"><p>⏸ 投票已截止，你未参与本场竞猜</p></div>
  <% } %>

  <!-- 实时投票面板 -->
  <div id="votes-panel">
    <%- include('partials/votes-panel', { match, effectiveStatus, allVotes, voteCounts }) %>
  </div>
</div>

<script>
const MATCH_ID = <%= match.id %>;
const HAS_VOTED = <%= myVote ? 'true' : 'false' %>;
const IS_FINISHED = '<%= effectiveStatus %>' === 'finished';
const OPT = {
  a: `<%= match.option_a.replace(/`/g,'\\`') %>`,
  b: `<%= match.option_b.replace(/`/g,'\\`') %>`,
  c: `<%= match.option_c.replace(/`/g,'\\`') %>`
};
</script>
<script src="/js/main.js"></script>
<script src="/js/realtime.js"></script>
<%- include('partials/footer') %>
