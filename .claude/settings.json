{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm start)",
      "Bash(npm run dev)",
      "Bash(node server.js)",
      "Bash(node scripts/update-odds.js)",
      "Bash(node scripts/update-scores.js)",
      "Bash(node scripts/import-matches.js)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:3000/*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(printenv)",
      "Read(./.env)",
      "Read(./worldcup.db.bin)",
      "Read(./.gist_id)"
    ]
  }
}
